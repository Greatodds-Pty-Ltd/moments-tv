# Copy to .env.local for local dev. Never commit real values.

# Auth.js: any random string locally (openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Shared Google OAuth client (same as BetCheck / dashboards / shortener).
# Needed only to sign in with Google locally; add http://localhost:3005/api/auth/callback/google to the client.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional: extra non-@s-b.co.za accounts, comma-separated
ALLOWED_EMAILS=

# Google Sheet + image folder. Leave blank locally to use sheet-template/.
GOOGLE_SHEET_ID=
GOOGLE_IMAGE_FOLDER_ID=
# Service account key JSON (raw or base64). Vercel secret only.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Upstash (added by the Vercel integration). Blank locally = in-memory store.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
